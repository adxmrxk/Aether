# Aether local development environment
# Copy to .env and fill in as needed:  cp .env.example .env
#
# Every value below has a working default for the local Docker stack, so an
# empty .env (or no .env at all) is enough to run `docker compose up -d`.

# ---------------------------------------------------------------------------
# GCP
# ---------------------------------------------------------------------------
# Used by the API, the BigQuery emulator and the Pub/Sub emulator.
# If you change this from local-dev, update the project id in
# infra/bigquery-schema.yaml to match or the emulator seed data won't be found.
GCP_PROJECT_ID=local-dev

# Region for Vertex AI. Only used against real GCP.
GCP_LOCATION=us-central1

# BigQuery dataset prefix. The API reads <dataset>_gold.
BIGQUERY_DATASET=aether_lakehouse

# ---------------------------------------------------------------------------
# Pinecone (optional)
# ---------------------------------------------------------------------------
# Leave blank to run without semantic search. /api/v1/search returns 503 when
# unset; every other endpoint works normally.
PINECONE_API_KEY=
PINECONE_INDEX=aether-market-vectors

# ---------------------------------------------------------------------------
# Ingest
# ---------------------------------------------------------------------------
# Which transport carries market data: pubsub (default) or kafka. Both end at
# the same Cloud Function; only one runs at a time, because both would write
# every record to Bronze twice.
INGEST_TRANSPORT=pubsub

# CoinGecko ids to track. Any number; one API call covers them all.
INGEST_COINS=bitcoin,ethereum,solana,cardano,ripple,dogecoin

# Seconds between upstream fetches, and between Bronze to Gold rebuilds.
INGEST_INTERVAL_SECONDS=60
GOLD_REBUILD_SECONDS=30
